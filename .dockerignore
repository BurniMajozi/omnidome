# Mobile app build artifacts (Gradle/Android outputs, ~9GB) — not part of any
# Docker image (only apps/web is containerized). Regenerable; keep out of context.
**/android/.gradle
**/android/build
**/android/app/build
**/android/.cxx
**/android/.kotlin
**/.cxx
**/*.apk
.gradle
# Local self-hosted Supabase runtime data (Postgres dir owned by another UID —
# unreadable, breaks build-context stat; not part of any image).
supabase/volumes
supabase/volumes/db/data
# Host-only dev overrides (service URLs on localhost). Next.js ranks .env.local
# above .env, and rewrites() are resolved at build time, so letting it into the
# image baked every /svc/* rewrite as localhost -- the web container proxied to
# itself and those routes 500'd. Railway builds from git, where it never exists.
apps/web/.env.local

