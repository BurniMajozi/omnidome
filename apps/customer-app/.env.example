# ─── API ────────────────────────────────────────────────────────────────
# Base URL for the customer API (web + native share this contract).
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# ─── EAS / Expo Updates ─────────────────────────────────────────────────
# Your real EAS project ID. Get it from `eas project:list` (or the EAS dashboard).
# Set locally with:  export EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# In CI/EAS, store as a secret:  eas secret:create EAS_PROJECT_ID <id>
# If unset, the build/submit will fail loudly instead of shipping a fake placeholder.
EAS_PROJECT_ID=

# ─── Dev-only mock data ──────────────────────────────────────────────────
# Set to "true" ONLY in local development to fall back to mock IoT dashboard
# data when the backend is unavailable. NEVER enable in production — it would
# show customers fake devices, cameras and events.
NEXT_PUBLIC_USE_MOCK=false
