POSTGRES_DB=coreconnect
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://admin:change_me@db:5432/coreconnect
PAYSTACK_SECRET_KEY=sk_test_mock_key

SMILE_ID_PARTNER_ID=your_partner_id
SMILE_ID_API_KEY=your_api_key

LICENSE_PATH=/etc/coreconnect/license.json
LICENSE_PUBLIC_KEY=CHANGE_ME_BASE64_OR_PEM
LICENSE_ENFORCEMENT=warn

ML_MODEL_PATH=/app/models/churn_model.pkl
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
ADMIN_SERVICE_URL=http://admin:8013
BILLING_SERVICE_URL=http://billing:8003
FINANCE_SERVICE_URL=http://finance:8015
CRM_SERVICE_URL=http://crm:8001
MARKETING_SERVICE_URL=http://marketing:8014
SALES_SERVICE_URL=http://sales:8002
RICA_SERVICE_URL=http://rica:8004
NETWORK_SERVICE_URL=http://network:8005
IOT_SERVICE_URL=http://iot:8006
# IoT: REQUIRED to store Home Assistant tokens (Fernet key). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it the integrations API answers 503. Tokens saved under the old derived default key are
# re-encrypted lazily on first use; if that fails the user must reconnect.
IOT_TOKEN_ENCRYPTION_KEY=
IOT_ENFORCE_ROLES=true
# Home Assistant URL policy: https only unless IOT_ALLOW_HTTP=true; LAN addresses (192.168.x / 10.x,
# *.local names) only when IOT_ALLOW_PRIVATE_HA=true. Loopback/link-local/metadata/docker names are always refused.
IOT_ALLOW_HTTP=false
IOT_ALLOW_PRIVATE_HA=false
CALL_CENTER_SERVICE_URL=http://call_center:8007
SUPPORT_SERVICE_URL=http://support:8008
HR_SERVICE_URL=http://hr:8009
INVENTORY_SERVICE_URL=http://inventory:8010
ANALYTICS_SERVICE_URL=http://analytics:8011
RETENTION_SERVICE_URL=http://retention:8012
COMPLIANCE_SERVICE_URL=http://compliance:8019
TENANT_MEMORY_SERVICE_URL=http://tenant_memory:8025
ORCHESTRATOR_URL=http://agent-orchestrator:8021
PRESENTON_SERVICE_URL=http://presenton:80
NEXT_PUBLIC_PRESENTON_URL=http://localhost:5000
AGENT_ORCHESTRATOR_ENABLE_TELEGRAM=false
BILLING_WEBHOOK_URL=
NETWORK_WEBHOOK_URL=
SALES_PROVISIONING_WEBHOOKS=

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public base URL of the web application used by backend services for invite links and redirects.
# Falls back to NEXT_PUBLIC_SITE_URL if omitted.
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_REDIRECT_URL=
# Authentication is invitation-only. OAuth providers are intentionally not shown by the web app.
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Auth & RBAC
# signed = backends only trust identity headers signed by the web tier with INTERNAL_AUTH_SECRET (recommended;
# compose default). header = trusts raw X-User-Id/X-Tenant-Id (dev/emergency only; logs a loud warning).
# Generate: python -c "import secrets;print(secrets.token_hex(32))"  (same value on web + every backend)
AUTH_MODE=signed
INTERNAL_AUTH_SECRET=
AUTH_ALLOW_ANONYMOUS=false
AUTH_DB_ENFORCE=true
AUTH_ENFORCE_MODULES=true
AUTH_ENFORCE_RBAC=true
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_VERIFY=true
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_SECRET=
DEFAULT_TENANT_ID=
DEFAULT_USER_ID=
DEFAULT_USER_PASSWORD_HASH=
ADMIN_AUTO_PROVISION=true

# Auto-create tables (matches Railway production behavior)
AUTO_CREATE_TABLES=true

# Gateway
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_CRM=120
RATE_LIMIT_SALES=120
RATE_LIMIT_BILLING=120
RATE_LIMIT_FINANCE=120
RATE_LIMIT_RICA=120
RATE_LIMIT_NETWORK=120
RATE_LIMIT_IOT=120
RATE_LIMIT_CALL_CENTER=120
RATE_LIMIT_SUPPORT=120
RATE_LIMIT_HR=120
RATE_LIMIT_INVENTORY=120
RATE_LIMIT_ANALYTICS=120
RATE_LIMIT_RETENTION=120
RATE_LIMIT_MEMORY=120
RATE_LIMIT_ADMIN=120
RATE_LIMIT_VOICE=120
RATE_LIMIT_SMS=120

# Voicebox (voice cloning/personalities/TTS/STT — call center, agents, webchat)
# VOICEBOX_ENGINE_URL points the voicebox adapter service at the heavy ML
# engine (services/voicebox/engine), which is NOT started by `docker compose
# up` by default — see the `voicebox-engine` service in docker-compose.yaml.
VOICEBOX_ENGINE_URL=http://voicebox-engine:17493
VOICEBOX_SERVICE_URL=http://voicebox:8027

# Unione (email)
UNIONE_API_KEY=your_unione_api_key

# Beeper Desktop API
BEEPER_DESKTOP_API_URL=http://localhost:23373
BEEPER_ACCESS_TOKEN=your_beeper_access_token

# OpenRouter (LLM for agents, web intel, tender extraction fallback, /api/ai/chat).
# Free ":free" models share one capacity pool across ALL OpenRouter users, so any
# of them can 429 or report "overloaded" regardless of our own volume. Callers try
# OPENROUTER_MODEL first, then each OPENROUTER_FALLBACK_MODELS entry in order.
# Use real model slugs (https://openrouter.ai/models), not display names.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free

# TypeSafe AI / Jev (System One calibrated decision models for dynamic tool gating & HITL)
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
JEV_GATE_ENABLED=true

# Firecrawl (web data extraction / scraping / search)
# Get a key at https://www.firecrawl.dev or use the keyless free tier (rate-limited).
# When empty, the web-intel routes degrade gracefully (HTTP 503 with a clear message)
# instead of crashing the service.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v2
# Optional: model used to *interpret* scraped content (competitor analysis, product
# research). Falls back to OPENROUTER_MODEL when unset.
FIRECRAWL_REASONING_MODEL=tencent/hy3

# Twilio Functions (serverless endpoints)
TWILIO_VOICE_FUNCTIONS_URL=
TWILIO_SMS_FUNCTIONS_URL=

# Sim Studio (hosted)
# Base URL of the hosted Sim instance, e.g. https://sim.your-domain.com
SIM_API_URL=
# Service key for Sim→OmniDome calls; never commit real values
SIM_API_KEY=
# Optional: default Sim workspace id for deep links
SIM_WORKSPACE_ID=
# Public base URL of hosted Sim for the Flow Builder link
NEXT_PUBLIC_SIM_URL=

# Railway production alignment (set automatically by Railway; documented for reference)
# AUTO_CREATE_TABLES=true
# LICENSE_ENFORCEMENT=warn
# PORT=8000 (per service)
# RAILWAY_PRIVATE_DOMAIN=<service>.railway.internal
# RAILWAY_PUBLIC_DOMAIN=<public-domain>
# INTERNAL_SERVICE_KEY=<shared-secret>
# CORS_ORIGINS=https://www.omnidome.co.za,https://omnidome.up.railway.app

# ── Zernio (social + messaging connectors: TikTok, Instagram, WhatsApp, etc.) ──
# Used by services/marketing. All three come from your Zernio dashboard.
# API key authenticates OmniDome -> Zernio (posting, inbox, account listing).
ZERNIO_API_KEY=
# Webhook secret verifies inbound Zernio deliveries (HMAC-SHA256).
# Supports comma-separated secrets for zero-downtime secret rotation: secret1,secret2
ZERNIO_WEBHOOK_SECRET=
# Profile id the /connect/{platform} OAuth flow attaches newly connected
# accounts to — REQUIRED for the Connections UI's "Connect" buttons to work.
ZERNIO_PROFILE_ID=
# Optional override; defaults to https://zernio.com/api/v1
# ZERNIO_BASE_URL=https://zernio.com/api/v1

# ── Marketing hardening (services/marketing) ──
# Zernio webhook is FAIL-CLOSED: 503 while ZERNIO_WEBHOOK_SECRET is unset. Explicit opt-out (logs CRITICAL per request):
# ZERNIO_WEBHOOK_ALLOW_UNSIGNED=true
# HMAC secret for email unsubscribe links (>=16 chars). Marketing email sends are refused (503) without it.
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
EMAIL_UNSUBSCRIBE_SECRET=
# Public base URL of the marketing service as seen by recipients, e.g. https://app.example.com/svc/marketing
# If unset, automatically defaults to ${APP_PUBLIC_URL}/svc/marketing.
EMAIL_UNSUBSCRIBE_BASE_URL=
# Max recipients per /email/send request (default 500) and per-tenant send requests per minute (default 10).
# EMAIL_MAX_RECIPIENTS=500
# EMAIL_RATE_PER_MIN=10
# Per-tenant SMS sends per minute (default 20). SMS uses the PLATFORM Twilio account and is platform_admin only.
# SMS_RATE_PER_MIN=20

# ── AgentMail (including admin invitation codes) ──
# API key authenticating OmniDome -> AgentMail.
AGENTMAIL_API_KEY=
# Default AgentMail inbox address, e.g. omnidome@agentmail.to
AGENTMAIL_INBOX=
# Svix signing secret (whsec_...) of the AgentMail webhook; verified via svix-id/svix-timestamp/svix-signature.
# Auto-learned by the keepalive worker when unset.
AGENTMAIL_WEBHOOK_SECRET=
# Public URL of communication's POST /api/v1/mail/webhook; the keepalive worker keeps a webhook pointed here.
AGENTMAIL_WEBHOOK_URL=
AGENTMAIL_WEBHOOK_CHECK_MINUTES=30
# Inbound polling fallback (ingests mail the webhook missed) and its lookback window.
AGENTMAIL_POLL_MINUTES=3
AGENTMAIL_POLL_LOOKBACK_HOURS=24
AGENTMAIL_WORKERS_ENABLED=true
# Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())").
# Required to store per-tenant AgentMail keys; without it tenant config is refused (env vars still work).
# Supports key rotation: comma-separated keys (new_key,old_key) or SECRETS_ENCRYPTION_KEY_PREVIOUS.
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_PREVIOUS=

# ── Orchestrator MCP endpoint (Hermes) ──
# Both must be set or /mcp/ answers 503.
# MCP_TENANT_ID is the tenant every MCP tool call runs as (the client X-Tenant-Id header is ignored).
# Supports key rotation: comma-separated keys in HERMES_API_KEY or HERMES_API_KEY_PREVIOUS.
HERMES_API_KEY=
HERMES_API_KEY_PREVIOUS=
MCP_TENANT_ID=

# ── SMTP (Transactional & Auth Email Delivery via Supabase GoTrue) ──
# Configures email delivery for user invites, password resets, and email verification.
# For local dev with Supabase mailer: supabase-mail:2500 (inbucket).
# For production: point to your SMTP relay (SendGrid, Postmark, AWS SES, etc.).
SMTP_ADMIN_EMAIL=noreply@omnidome.co.za
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=OmniDome
